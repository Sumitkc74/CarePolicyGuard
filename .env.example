# ==============================================================================
# CarePolicyGuard Production Environment Configuration
# ==============================================================================

PROJECT_NAME=CarePolicyGuard
VERSION=1.0.0
DESCRIPTION=Policy-Aware Multi-Agent Clinical Evidence & Coverage Verification Engine
API_V1_PREFIX=/api/v1

# Security & Cryptographic Tokens (Required: must be set, no default provided)
# Generate a random 48-character key using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence (SQLite default for zero-config; PostgreSQL for enterprise)
DATABASE_URL=sqlite:///./carepolicyguard.db

# Safety & Governance Thresholds (CMS-0057-F Calibrated Gate)
ABSTENTION_THRESHOLD=0.85
ENABLE_PHI_MASKING=true

# Host & Networking Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["*"]

# Live SMTP Verification Delivery (Optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=auth@carepolicyguard.med

# Federated OAuth Single Sign-On (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo User Seeding (Development-only: strictly ignored in production. Required only if SEED_DEMO_USERS=true; never commit secrets)
SEED_DEMO_USERS=false
DEMO_ADMIN_PASSWORD=
DEMO_AUDITOR_PASSWORD=
DEMO_CLINICIAN_PASSWORD=
DEMO_DOCTOR_PASSWORD=
