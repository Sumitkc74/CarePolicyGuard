# ==============================================================================
# CarePolicyGuard Production Environment Configuration
# ==============================================================================

PROJECT_NAME=CarePolicyGuard
VERSION=1.0.0
DESCRIPTION=Policy-Aware Multi-Agent Clinical Evidence & Coverage Verification Engine
API_V1_PREFIX=/api/v1

# Security & Cryptographic Tokens (Generate random 64-char key in production)
SECRET_KEY=carepolicyguard-deterministic-clinical-secret-key-3849104812
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence (SQLite default for zero-config; PostgreSQL for enterprise)
DATABASE_URL=sqlite:///./carepolicyguard.db

# Safety & Governance Thresholds (CMS-0057-F Calibrated Gate)
ABSTENTION_THRESHOLD=0.85
ENABLE_PHI_MASKING=true

# Host & Networking Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["*"]

# Live SMTP Verification Delivery (Optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=auth@carepolicyguard.med

# Federated OAuth Single Sign-On (Google & Apple)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Default Evaluator Credentials
DEFAULT_ADMIN_USER=admin@carepolicyguard.med
DEFAULT_ADMIN_PASS=AdminGuard!2026
DEFAULT_AUDITOR_USER=auditor@medicare.cms.gov
DEFAULT_AUDITOR_PASS=AuditorSecure!2026
DEFAULT_CLINICIAN_USER=clinician@hospital.org
DEFAULT_CLINICIAN_PASS=ClinicianCare!2026

