      "name": "Successful Intrathecal Preliminary Trial Response",
      "description": "Documented positive clinical response (>= 50% pain reduction or reduction in intolerable side effects) to a temporary preliminary trial injection of intrathecal medication.",
      "clinical_intent": "Verify trial responsiveness before permanent implantation",
      "criterion_type": "FINDING_PRESENCE",
