    {
      "criterion_code": "CRIT-KORTH-02",
      "name": "Medical Justification for Custom vs Prefabricated Device",
      "description": "Documented anatomical justification why an off-the-shelf prefabricated brace cannot fit (e.g. disproportionate thigh/calf circumference, severe angular deformity > 15 degrees).",
      "clinical_intent": "Mandatory justification for custom fabrication",
      "criterion_type": "FINDING_PRESENCE",
      "entity_names": [
