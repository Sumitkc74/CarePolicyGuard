      "version": "2024.1",
      "date": "2024-01-01",
      "author": "DME MAC",
      "summary": "Annual orthotics review."
    }
  ],
  "criteria": [
    {
      "criterion_code": "CRIT-KORTH-01",
      "name": "Documented Objective Knee Laxity or Ligamentous Deficiency",
      "description": "Physical examination documenting Grade II or III ligamentous instability on anterior drawer, Lachman, pivot shift, or varus/valgus stress testing.",
      "clinical_intent": "Confirm objective mechanical laxity",
      "criterion_type": "FINDING_PRESENCE",
      "entity_names": [
        "positive lachman test",
        "grade 2 ligamentous instability",
        "acl tear with instability",
        "abnormal pivot shift"
      ],
      "operator": null,
      "threshold": null,
      "target_unit": null,
      "ordinal_allowed": null,
      "min_duration_days": null,
      "is_exclusion": false,
      "negation_sensitive": true,
      "required_temporal_window": "Current clinical encounter",
      "icd10_preconditions": [],
      "cpt_preconditions": [],
      "min_score": 0.85,
      "keywords": [
        "positive lachman test",
        "grade 2 ligamentous instability",
        "acl tear with instability",
