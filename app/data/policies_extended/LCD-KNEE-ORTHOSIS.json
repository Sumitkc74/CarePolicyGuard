{
  "policy_id": "LCD-KNEE-ORTHOSIS",
  "title": "Custom-Fabricated Functional Knee Orthoses",
  "jurisdiction": "DME MAC Local Coverage Determination",
  "effective_date": "2023-01-01",
  "category": "Durable Medical Equipment (DMEPOS)",
  "description": "DME MAC coverage criteria for custom-fabricated functional knee orthoses (HCPCS L1845, L1846). Requires documented chronic knee instability resulting from ligamentous deficiency (ACL, PCL, MCL/LCL) or severe osteoarthritis, failed trial of prefabricated orthosis, and specific physical exam laxity measurements.",
  "policy_version": "2024.1",
  "change_log": [
