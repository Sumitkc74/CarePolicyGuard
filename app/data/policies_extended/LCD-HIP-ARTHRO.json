  "policy_id": "LCD-HIP-ARTHRO",
  "title": "Total Hip Arthroplasty (THA) for End-Stage Osteoarthritis",
  "jurisdiction": "Medicare Administrative Contractor (MAC) LCD",
  "effective_date": "2023-01-01",
  "category": "Orthopedic Surgery",
  "description": "Medicare coverage guidelines for elective primary total hip arthroplasty. Requires advanced radiographic osteoarthritis (severe joint space narrowing, subchondral sclerosis, osteophytes), severe functional disability in daily living, and failure of at least 3 months of conservative therapy.",
