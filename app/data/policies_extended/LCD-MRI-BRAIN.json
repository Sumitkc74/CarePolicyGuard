{
  "policy_id": "LCD-MRI-BRAIN",
  "title": "Magnetic Resonance Imaging (MRI) of the Brain with and without Contrast",
  "jurisdiction": "Medicare Administrative Contractor (MAC) LCD",
  "effective_date": "2023-01-01",
  "category": "Diagnostic Radiology / Neuroradiology",
  "description": "Medicare coverage criteria for diagnostic brain MRI. Requires documented focal neurological deficit, new onset seizure, intractable cognitive decline with rapid progression, suspected demyelinating disease (MS), or persistent progressive headache accompanied by focal neurological signs.",
