  "criteria": [
    {
      "criterion_code": "CRIT-MRIB-01",
      "name": "Focal Neurological Deficit or New Onset Seizure",
      "description": "Clinical examination documenting objective focal neurological deficit (cranial neuropathy, hemiparesis, visual field loss, ataxia) or new-onset unprovoked seizure.",
      "clinical_intent": "Validate neurological indication for parenchymal evaluation",
      "criterion_type": "FINDING_PRESENCE",
      "entity_names": [
        "focal neurological deficit",
        "new onset seizure",
        "cranial nerve palsy",
        "hemiparesis",
        "suspected stroke"
      ],
      "operator": null,
      "threshold": null,
      "target_unit": null,
      "ordinal_allowed": null,
      "min_duration_days": null,
      "is_exclusion": false,
      "negation_sensitive": true,
      "required_temporal_window": "Current clinical presentation",
      "icd10_preconditions": [],
      "cpt_preconditions": [],
      "min_score": 0.85,
      "keywords": [
