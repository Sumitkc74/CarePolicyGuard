      "criterion_code": "CRIT-SHLD-01",
      "name": "Advanced Glenohumeral Arthropathy or Cuff Tear Arthropathy",
      "description": "Radiographs or MRI demonstrating severe glenohumeral joint space narrowing, subchondral sclerosis, or Hamada Stage 3+ rotator cuff tear arthropathy.",
      "clinical_intent": "Confirm structural joint destruction",
      "criterion_type": "FINDING_PRESENCE",
      "entity_names": [
        "glenohumeral osteoarthritis",
        "cuff tear arthropathy",
        "severe shoulder arthritis",
        "subchondral sclerosis of glenoid"
