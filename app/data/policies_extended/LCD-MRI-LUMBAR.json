  "policy_id": "LCD-MRI-LUMBAR",
  "title": "Magnetic Resonance Imaging (MRI) of the Lumbar Spine",
  "jurisdiction": "Medicare Administrative Contractor (MAC) LCD",
  "effective_date": "2023-01-01",
  "category": "Diagnostic Radiology",
  "description": "Medicare coverage criteria for non-emergent lumbar spine MRI. Requires severe radicular pain with positive neurological sign (straight leg raise, reflex loss) unresponsive to at least 6 weeks of conservative care, or presence of 'red flag' symptoms (suspected cauda equina, fever/infection, history of cancer).",
  "policy_version": "2024.1",
  "change_log": [
