      "date": "2024-01-01",
      "author": "CMS MAC",
      "summary": "Annual advanced imaging review."
    }
  ],
  "criteria": [
    {
      "criterion_code": "CRIT-MRIL-01",
      "name": "Radicular Deficit After 6 Weeks Conservative Care or Red Flag",
      "description": "Documented dermatomal radicular symptoms refractory to >= 6 weeks of conservative therapy, or immediate red flags: progressive motor deficit, suspected infection, or history of malignancy.",
      "clinical_intent": "Prevent premature MRI for acute uncomplicated back strain",
      "criterion_type": "FINDING_PRESENCE",
      "entity_names": [
        "failed 6 weeks conservative therapy",
        "lumbar radiculopathy",
