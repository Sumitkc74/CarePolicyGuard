      "criterion_code": "CRIT-EVAR-01",
      "name": "Abdominal Aortic Aneurysm Diameter (>= 5.5 cm in Men / >= 5.0 cm in Women)",
      "description": "Computed tomography angiography (CTA) confirming maximum transverse infrarenal AAA diameter >= 5.5 cm (men) or >= 5.0 cm (women), or expansion > 0.5 cm in 6 months.",
      "clinical_intent": "Threshold diameter for rupture risk exceeding elective intervention risk",
      "criterion_type": "NUMERIC_THRESHOLD",
      "entity_names": [
