      "criterion_code": "CRIT-PACE-01",
      "name": "High-Grade AV Block or Symptomatic Sinus Pauses (>= 3.0 Seconds)",
      "description": "Electrocardiographic documentation of persistent third-degree AV block, Mobitz II second-degree block, or sinus pauses >= 3.0 seconds correlating with presyncope/syncope.",
      "clinical_intent": "Objective electrophysiologic threshold for pacing",
      "criterion_type": "FINDING_PRESENCE",
      "entity_names": [
        "third degree av block",
        "complete heart block",
