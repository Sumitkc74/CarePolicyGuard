  "title": "Permanent Cardiac Pacemakers for Bradyarrhythmias",
  "jurisdiction": "National Coverage Determination (CMS)",
  "effective_date": "2020-01-01",
  "category": "Cardiology / Electrophysiology",
  "description": "CMS National Coverage Determination for single and dual chamber permanent cardiac pacemakers (NCD 20.8). Requires documented symptomatic sinus node dysfunction (bradycardia, pauses > 3 seconds with syncope) or high-grade / Mobitz Type II second-degree or third-degree atrioventricular (AV) block.",
  "policy_version": "2024.1",
